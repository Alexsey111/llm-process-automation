# Скопируйте в .env и подставьте свой ключ.
# Подойдёт любой OpenAI-совместимый провайдер (DeepSeek, OpenAI, vLLM и т.д.)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Пути
DB_PATH=data/automation.db

# Параметры LLM
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT=60
USE_JSON_MODE=true
LLM_MAX_RETRIES=2